# Arch based brew
alias ibrew="arch -x86_64 /usr/local/homebrew/bin/brew"
alias brew="/opt/homebrew/bin/brew"

# User specific aliases
alias home='cd ~' 
alias wnotes='vim ~/Documents/obsidian/Work/notes.md'
alias pnotes='vim ~/Documents/obsidian/Personal/notes.md'
alias local-notes='vim ~/local-notes.md'

if [ -n "$ZSH_VERSION" ]; then
	alias reload='source ~/.zshrc'
elif [ -n "$BASH_VERSION" ]; then
	alias reload='source ~/.bash_profile'
fi

# Editor
alias vi='nvim'
alias vim='nvim'

# Git
alias gup='git pull --rebase'
alias gapa='git add --patch'
alias gpf='git push --force-with-lease'
alias gco='git branch | sed "s/^[* ]*//" | fzf | xargs git checkout'

# Command line oldies
alias ll='ls -lisa'
alias lr='ls -hartl'

if [[ "$OSTYPE" == "darwin"* ]]; then 
	alias sfiles='defaults write com.apple.finder AppleShowAllFiles YES'
	alias hfiles='defaults write com.apple.finder AppleShowAllFiles NO'
fi

# Curl with [O] filename same as resource in the URL, [L]ocation redirects
alias get='curl -OL'

# Kubernetes
alias k='kubectl'
alias kg='kubectl get'                                                          
alias kd='kubectl describe'                                                     
alias kr='kubectl delete'                                                       
alias kl='kubectl logs'                                                         
alias ke='kubectl exec -it'                                                     
alias kt='kubectl top'
alias load-minikube='cp ~/.kube/minikube-config ~/.kube/config'
alias load-awskube='cp ~/.kube/stroeer-labs-config ~/.kube/config'

# Calendar tool
alias jan='cal -m 01'
alias feb='cal -m 02'
alias mar='cal -m 03'
alias apr='cal -m 04'
alias may='cal -m 05'
alias jun='cal -m 06'
alias jul='cal -m 07'
alias aug='cal -m 08'
alias sep='cal -m 09'
alias oct='cal -m 10'
alias nov='cal -m 11'
alias dec='cal -m 12'

# Tmux sessions: attach if it exists, create it otherwise
alias tmux='tmux new -As main -c ~'
alias main='tmux new -As main -c ~'
alias ssp='tmux new -As ssp -c ~/development/ssp-core'
alias middleware='tmux new -As middleware -c ~/development/pim-dam-middleware-stroeer'
alias myself='tmux new -As myself -c ~/development/playground/myself'
alias finny='tmux new -As finny -c ~/development/playground/finny'
